[Unit]
Description=voipms-sms-gateway (voip.ms <-> Telegram SMS/MMS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace YOUR_USER and the path with where you cloned the repo.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/voipms-sms-gateway
ExecStart=/home/YOUR_USER/voipms-sms-gateway/.venv/bin/python -m smsgw
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
