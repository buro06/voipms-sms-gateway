# Copy to .env in the repo folder and `chmod 600` it.

# voip.ms: Main Menu > SOAP and REST/JSON API. Enable the API, set an API password,
# and add your public IP (the one FreePBX and this VM share) to the allowed IPs.
VOIPMS_API_USERNAME=you@example.com
VOIPMS_API_PASSWORD=change-me
VOIPMS_DID=5145550000

# Telegram: token from @BotFather. Leave TELEGRAM_CHAT_ID=0 at first, start the
# service, post any message in your group, and the bot replies with the chat id.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=0
# Optional: comma-separated Telegram user ids allowed to send texts (empty = whole group).
ALLOWED_USER_IDS=

# Random path secret for the voip.ms callback URL: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

DB_PATH=smsgw.db
# Keep in sync with your voip.ms API send limit (100/day unless raised).
DAILY_SEND_LIMIT=100
RECONCILE_INTERVAL=300
# mms = text over 160 chars goes as one MMS; split = several 160-char SMS
LONG_TEXT_MODE=mms
MMS_MAX_IMAGE_BYTES=600000
LOG_LEVEL=INFO
